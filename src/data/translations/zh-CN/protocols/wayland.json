{
  "description": {
    "summary": "核心 Wayland 协议",
    "text": "核心 Wayland 协议由 wayland.xml 描述，包含了 Wayland 系统的核心接口。"
  },
  "interfaces": {
    "wl_display": {
      "description": {
        "summary": "核心全局对象",
        "text": "核心全局对象。这是一个特殊的单例对象，用于内部 Wayland 协议功能。"
      },
      "requests": {
        "sync": {
          "description": {
            "summary": "异步回送",
            "text": "sync 请求要求服务器在返回的 wl_callback 对象上发出 'done' 事件。由于请求和事件都是按顺序处理和交付的，因此这可以用作屏障，以确保之前所有的请求和产生的事件都已处理完毕。\n\n此请求返回的对象将在回调触发后被合成器销毁，因此客户端在此时点后不得尝试使用它。\n\n回调中传递的 callback_data 未定义，应忽略。"
          }
        },
        "get_registry": {
          "description": {
            "summary": "获取全局注册表对象",
            "text": "此请求创建一个注册表对象，允许客户端列出并绑定合成器提供的全局对象。\n\n需要注意的是，响应 get_registry 请求所消耗的服务器端资源只能在客户端断开连接时释放，而不是在客户端代理销毁时释放。因此，客户端应尽可能少地调用 get_registry，以避免浪费内存。"
          }
        }
      },
      "events": {
        "error": {
          "description": {
            "summary": "致命错误事件",
            "text": "当发生致命（不可恢复）错误时发出错误事件。object_id 参数是发生错误的位点，通常是响应对该对象的请求。code 标识错误，由对象接口定义。因此，每个接口都定义了自己的错误代码集。message 是错误的简短描述，用于（调试）方便。"
          }
        },
        "delete_id": {
          "description": {
            "summary": "确认对象 ID 删除",
            "text": "此事件由对象 ID 管理逻辑内部使用。当客户端删除其创建的对象时，服务器将发送此事件以确认已看到删除请求。当客户端收到此事件时，它将知道可以安全地重用该对象 ID。"
          }
        }
      },
      "enums": {
        "error": {
          "description": {
            "summary": "全局错误值",
            "text": "这些错误是全局性的，可以响应任何服务器请求而发出。"
          }
        }
      }
    },
    "wl_registry": {
      "description": {
        "summary": "全局注册表对象",
        "text": "单例全局注册表对象。服务器拥有许多对所有客户端都可用的全局对象。这些对象通常代表服务器中的实际对象（例如输入设备），或者是提供扩展功能的单例对象。\n\n当客户端创建注册表对象时，注册表对象会为当前注册表中的每个全局对象发出一个 global 事件。全局对象会因设备或显示器的热插拔、重新配置或其他事件而出现或消失，注册表将发送 global 和 global_remove 事件，以使客户端了解最新的更改。为了标记初始事件迸发的结束，客户端可以在调用 wl_display.get_registry 后立即使用 wl_display.sync 请求。\n\n客户端可以使用 bind 请求绑定到全局对象。这将创建一个客户端句柄，让对象向客户端发送事件，并允许客户端对该对象调用请求。"
      },
      "requests": {
        "bind": {
          "description": {
            "summary": "将对象绑定到显示器",
            "text": "使用指定的名称作为标识符，将客户端创建的新对象绑定到服务器。"
          }
        }
      },
      "events": {
        "global": {
          "description": {
            "summary": "宣告全局对象",
            "text": "通知客户端全局对象的信息。\n\n此事件通知客户端，具有给定名称的全局对象现在可用，并且它实现了给定接口的给定版本。"
          }
        },
        "global_remove": {
          "description": {
            "summary": "宣告移除全局对象",
            "text": "通知客户端已移除全局对象。\n\n此事件通知客户端，由名称标识的全局对象不再可用。如果客户端使用 bind 请求绑定到了该全局对象，则客户端现在应该销毁该对象。\n\n在客户端销毁该对象之前，该对象仍然有效，并且对该对象的请求将被忽略，以避免全局对象消失与客户端向其发送请求之间的竞争。"
          }
        }
      }
    },
    "wl_callback": {
      "description": {
        "summary": "回调对象",
        "text": "客户端可以处理 'done' 事件，以便在相关请求完成时得到通知。\n\n注意，由于 wl_callback 对象是从多个独立的工厂接口创建的，因此 wl_callback 接口被冻结在版本 1。"
      },
      "events": {
        "done": {
          "description": {
            "summary": "完成事件",
            "text": "在相关请求完成时通知客户端。"
          }
        }
      }
    },
    "wl_compositor": {
      "description": {
        "summary": "合成器单例",
        "text": "合成器。此对象是一个全局单例。合成器负责将多个表面的内容组合成一个可显示的输出。"
      },
      "requests": {
        "create_surface": {
          "description": {
            "summary": "创建新表面",
            "text": "请求合成器创建一个新表面。"
          }
        },
        "create_region": {
          "description": {
            "summary": "创建新区域",
            "text": "请求合成器创建一个新区域。"
          }
        }
      }
    },
    "wl_shm_pool": {
      "description": {
        "summary": "共享内存池",
        "text": "wl_shm_pool 对象封装了一块由文件描述符支持的共享内存，客户端可以从中分配 wl_buffer 对象。池中的所有缓冲区共享相同的文件描述符，并在合成器中被映射到同一内存块中。"
      },
      "requests": {
        "create_buffer": {
          "description": {
            "summary": "从池中创建缓冲区",
            "text": "从池中创建一个 wl_buffer 对象。"
          }
        },
        "destroy": {
          "description": {
            "summary": "销毁池",
            "text": "销毁共享内存池。"
          }
        },
        "resize": {
          "description": {
            "summary": "调整池大小",
            "text": "调整共享内存池的大小。"
          }
        }
      }
    },
    "wl_shm": {
      "description": {
        "summary": "共享内存支持",
        "text": "一个允许客户端分配共享内存缓冲区的全局单例。"
      },
      "requests": {
        "create_pool": {
          "description": {
            "summary": "创建内存池",
            "text": "创建一个共享内存池。"
          }
        }
      },
      "events": {
        "format": {
          "description": {
            "summary": "支持的像素格式",
            "text": "在绑定时，此事件会告知客户端支持哪些像素格式。"
          }
        }
      },
      "enums": {
        "error": {
          "description": {
            "summary": "wl_shm 错误值",
            "text": "这些错误可以在响应 wl_shm 请求时发出。"
          }
        },
        "format": {
          "description": {
            "summary": "像素格式",
            "text": "此枚举描述了缓冲区的像素格式。"
          }
        }
      }
    },
    "wl_buffer": {
      "description": {
        "summary": "内容缓冲区",
        "text": "缓冲区提供表面的内容。典型的缓冲区具有由一系列像素组成的数据，这些像素可以读取并组合到显示输出中。也可以存在其他类型的缓冲区，其实现由协议扩展定义。"
      },
      "requests": {
        "destroy": {
          "description": {
            "summary": "销毁缓冲区",
            "text": "销毁缓冲区。"
          }
        }
      },
      "events": {
        "release": {
          "description": {
            "summary": "释放缓冲区",
            "text": "合成器发出此事件，表示它不再使用此缓冲区的内容，客户端现在可以重用它或销毁它。"
          }
        }
      }
    },
    "wl_data_offer": {
