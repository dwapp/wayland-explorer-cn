{
  "interfaces": {
    "treeland_personalization_manager_v1": {
      "description": {
        "type": "description",
        "text": "此接口允许客户端自定义显示效果。\n\n警告！此文件中描述的协议目前处于测试阶段。可能会在相应的接口版本更新中添加向后兼容的更改。向后不兼容的更改只能通过创建新的扩展主版本来完成。",
        "summary": "个性化管理器"
      },
      "requests": {
        "get_window_context": {
          "description": {
            "type": "description",
            "text": "根据上下文设置窗口背景和阴影",
            "summary": "获取个性化窗口上下文"
          }
        },
        "get_wallpaper_context": {
          "description": {
            "type": "description",
            "text": "自定义用户壁纸",
            "summary": "自定义壁纸上下文"
          }
        },
        "get_cursor_context": {
          "description": {
            "type": "description",
            "text": "自定义用户光标",
            "summary": "自定义光标上下文"
          }
        },
        "get_font_context": {
          "description": {
            "type": "description",
            "text": "自定义 treeland 和窗口全局字体上下文",
            "summary": "自定义 treeland 和窗口全局字体上下文"
          }
        },
        "get_appearance_context": {
          "description": {
            "type": "description",
            "text": "自定义用户 treeland 窗口外观全局设置",
            "summary": "自定义 treeland 窗口全局设置上下文"
          }
        }
      }
    },
