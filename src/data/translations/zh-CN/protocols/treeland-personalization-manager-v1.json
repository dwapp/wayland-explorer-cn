        "set_round_corner_radius": {
          "description": {
            "type": "description",
            "text": "此请求设置窗口圆角半径，调用此请求表示用户希望自行管理窗口圆角半径。如果未调用，窗口圆角半径将由合成器决定。",
            "summary": "设置窗口圆角半径"
          }
        },
        "set_shadow": {
          "description": {
            "type": "description",
            "text": "设置窗口阴影的半径、偏移和颜色，调用此请求表示客户端希望自行管理窗口阴影。如果未调用，窗口阴影将由合成器决定。",
            "summary": "设置窗口阴影"
          }
        },
        "set_border": {
          "description": {
            "type": "description",
            "text": "设置窗口边框宽度和颜色",
            "summary": "设置窗口边框"
