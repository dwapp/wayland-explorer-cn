          }
        },
        "destroy": {
          "description": {
            "type": "description",
            "text": "销毁上下文对象。",
            "summary": "销毁上下文对象"
          }
        }
      },
      "enums": {
        "blend_mode": {
          "description": {
            "type": "description",
            "text": "窗口混合模式定义合成器如何将窗口表面合成到其他表面之上。",
            "summary": "窗口混合模式"
          },
          "entries": {
            "transparent": {
              "summary": "普通混合模式，仅使用 alpha 通道将窗口合成到背景之上"
            },
            "wallpaper": {
              "summary": "将窗口合成到壁纸之上"
            },
            "blur": {
              "summary": "模糊窗口背景的内容"
            }
          }
        },
        "enable_mode": {
          "description": {
            "type": "description",
            "text": "设置窗口启用模式",
            "summary": "窗口启用模式"
          },
          "entries": {
